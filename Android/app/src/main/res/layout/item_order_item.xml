<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/steel_dark"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="#4A5867"
    app:strokeWidth="1dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:text="🚀 Взять в работу"
        android:textAllCaps="false"
        android:textColor="@color/metal_bg_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_laser_button" />

    <LinearLayout
        android:id="@+id/crewRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"

        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrew"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="👥 Состав бригады"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_steel_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRelease"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Отказаться"
            android:textAllCaps="false"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:background="@drawable/bg_steel_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPartNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Деталь: —"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 шт."
            android:textColor="@color/laser_glow"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSpec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Толщина: — · Марка: — · Маршрут: —"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Выполнено: 0 · Осталось: 0"
        android:textColor="@color/laser_glow"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvClaim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>