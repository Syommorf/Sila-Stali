<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_metal_screen">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF"
        app:title="Экспорт в Excel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDateFrom"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="От:"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_steel_button"
            android:padding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDateFrom"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="📅 Выбрать"
            android:background="@drawable/bg_laser_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDateTo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="До:"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_steel_button"
            android:padding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDateTo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="📅 Выбрать"
            android:background="@drawable/bg_laser_button" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExport"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="24dp"
        android:text="📥 Скачать Excel"
        android:textColor="@color/metal_bg_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_laser_button" />

</LinearLayout>
