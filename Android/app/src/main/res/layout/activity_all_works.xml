<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_metal_screen">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF"
        app:title="Все работы" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDateFrom"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="От:"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_steel_button"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvDateTo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="До:"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_steel_button"
            android:padding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDateFrom"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="📅"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_laser_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDateTo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:text="📅"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_laser_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etPartFilter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Фильтр по детали"
            android:inputType="text"
            android:textSize="14sp"
            android:background="@drawable/bg_steel_button"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:padding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:text="🔍"
            android:background="@drawable/bg_laser_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:text="✕"
            android:background="@drawable/bg_steel_button" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="Нет работ"
        android:textColor="@color/text_muted"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
