<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#2E3945"
                android:centerColor="#232D37"
                android:endColor="#1A222A"
                android:type="linear" />
        </shape>
    </item>
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FF8C1A"
                android:centerColor="#FFFF8C1A"
                android:endColor="#00FF8C1A"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="6dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <stroke
                android:width="1dp"
                android:color="#338A99A8"
                android:dashGap="7dp"
                android:dashWidth="2dp" />
        </shape>
    </item>
</layer-list>