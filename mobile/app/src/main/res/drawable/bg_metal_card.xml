<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="135"
                android:startColor="#2E3945"
                android:centerColor="#232D37"
                android:endColor="#2A3440"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#4A5867" />
        </shape>
    </item>

    <!-- ряд «заклёпок» — пунктирная рамка по внутреннему краю -->
    <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <stroke
                android:width="2dp"
                android:color="#8A99A8"
                android:dashGap="7dp"
                android:dashWidth="2dp" />
        </shape>
    </item>

    <!-- лазерный блик снизу-справа -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="12dp"
        android:alpha="0.35">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:startColor="#0AFF8C1A"
                android:centerColor="#00FF8C1A"
                android:endColor="#FFFF8C1A"
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.85"
                android:centerY="0.9" />
        </shape>
    </item>
</layer-list>